<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:PhotoCloud.App"
        x:Class="PhotoCloud.App.MainWindow"
        Width="900" Height="650"
        Icon="/Assets/photocloud.ico"
        Title="PhotoCloud">
    <Grid RowDefinitions="Auto,Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <Image Source="/Assets/banana.png" Width="96" Height="96"/>
            <TextBlock Text="PhotoCloud" FontSize="36" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TabControl Grid.Row="2">
            <TabItem Header="Log">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <TextBlock Text="Filter" VerticalAlignment="Center"/>
                        <ComboBox Name="LevelFilter" SelectedIndex="0" Width="140">
                            <ComboBoxItem>Alle</ComboBoxItem>
                            <ComboBoxItem>Nur Fehler</ComboBoxItem>
                            <ComboBoxItem>Nur Info</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <ListBox Grid.Row="1" Name="LogList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:LogRow">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontWeight="Bold" Width="18"/>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Name="SettingsPanel" Spacing="8" IsEnabled="False">
                        <TextBlock Name="SettingsConfigPath" TextWrapping="Wrap"/>
                        <TextBlock Text="Gespeicherte Änderungen werden nach einem Neustart von PhotoCloud wirksam." TextWrapping="Wrap"/>

                        <TextBlock Text="Cloud / NAS" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Host"/>
                        <TextBox Name="CloudHostBox"/>
                        <TextBlock Text="Freigabe (Share)"/>
                        <TextBox Name="CloudShareBox"/>
                        <TextBlock Text="Benutzername (optional, wenn Windows bereits Zugriff hat)"/>
                        <TextBox Name="CloudUserBox"/>
                        <TextBlock Text="Passwort"/>
                        <TextBox Name="CloudPasswordBox" PasswordChar="*"/>
                        <CheckBox Name="ClearCloudPasswordCheckBox" Content="Gespeichertes Passwort löschen"/>
                        <TextBlock Text="Ein leeres Passwortfeld lässt das gespeicherte Passwort unverändert. Zum Entfernen das Kontrollkästchen aktivieren."
                                   TextWrapping="Wrap"/>
                        <TextBlock Name="CloudPortNotice" TextWrapping="Wrap"/>
                        <TextBlock Text="Das Passwort wird weiterhin unverschlüsselt in der JSON-Datei gespeichert. Es wird in der Oberfläche maskiert und nicht protokolliert."
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Webserver" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Server-Port"/>
                        <TextBox Name="ServerPortBox"/>
                        <TextBlock Text="Erlaubte Client-IPv4-Adressen (eine pro Zeile)"/>
                        <TextBox Name="AllowedClientIpsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="84"/>

                        <TextBlock Text="Cloud-Speicher" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Zielordner relativ zur Freigabe (einer pro Zeile; Ordner müssen bereits existieren)"/>
                        <TextBox Name="TargetFoldersBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="84"/>
                        <TextBlock Text="Beim Speichern wird der Pfad geprüft. Ob Ordner und NAS erreichbar sind, zeigt sich beim Upload."
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Maximale Bildgröße in MB"/>
                        <TextBox Name="MaxFileSizeBox"/>
                        <TextBlock Text="Erlaubte Dateiendungen (eine pro Zeile, z. B. .jpg)"/>
                        <TextBox Name="AllowedExtensionsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="84"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Name="SaveSettingsButton" Content="Einstellungen speichern"/>
                            <Button Name="RestartSettingsButton" Content="Jetzt neu starten" IsVisible="False"/>
                        </StackPanel>
                        <TextBlock Text="Ein Neustart beendet den Webserver; laufende Uploads können abbrechen."
                                   TextWrapping="Wrap"/>
                        <TextBlock Name="SettingsMessage" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
